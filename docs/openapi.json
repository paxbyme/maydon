  "info": {
    "title": "MAYDON API",
    "description": "Identity and scoped access APIs; reservation and game endpoints are pending.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "example": "maydon-api"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          },
          "apiVersion": {
            "type": "string",
            "example": "v1"
          }
        },
        "required": [
          "service",
          "version",
          "apiVersion"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          },
          "displayName": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "uz",
              "ru",
              "en"
            ]
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "AcceptedResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "accepted"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "ChallengeDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "code"
        ]
      },
      "VerifiedResponse": {
        "type": "object",
        "properties": {
          "verified": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "verified"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "code",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "client": {
            "type": "string",
            "enum": [
              "web",
              "mobile"
            ],
            "default": "web"
          }
        },
        "required": [
          "email",
          "password",
          "client"
        ]
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "uz",
              "ru",
              "en"
            ]
          },
          "emailVerified": {
            "type": "boolean"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "phoneVerified": {
            "type": "boolean"
          },
          "mfaEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "locale",
          "emailVerified",
          "phone",
          "phoneVerified",
          "mfaEnabled"
        ]
      },
      "TokensResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "example": 900
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string",
            "description": "Mobile clients only. Web refresh credentials are HttpOnly cookies."
          },
          "mfaRequired": {
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/ProfileResponse"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "refreshExpiresAt",
          "mfaRequired",
          "user"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string",
            "enum": [
              "web",
              "mobile"
            ],
            "default": "web"
          },
          "refreshToken": {
            "type": "string",
            "description": "Mobile clients only; web uses a Secure HttpOnly cookie."
          }
        },
        "required": [
          "client"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "uz",
              "ru",
              "en"
            ]
          }
        }
      },
      "PhoneDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+998901234567"
          }
        },
        "required": [
          "phone"
        ]
      },
      "RevokedResponse": {
        "type": "object",
        "properties": {
          "revoked": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "revoked"
        ]
      },
      "MfaSetupDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ]
      },
      "MfaSetupResponse": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Enrollment secret; never log or persist in browser storage."
          },
          "uri": {
            "type": "string"
          }
        },
        "required": [
          "secret",
          "uri"
        ]
      },
      "MfaCodeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "AssignmentDto": {
        "type": "object",
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "MANAGER",
              "BOOKING_CLERK",
              "VIEWER"
            ]
          }
        },
        "required": [
          "preset"
        ]
      }
    }
  }
}
