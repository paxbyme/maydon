{
  "name": "@maydon/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "openapi": "npm run build && node dist/src/export-openapi.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate deploy",
    "db:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/test/integration/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "redis": "5.9.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
